DATABASE_URL=postgresql+psycopg2://ocr_user:ocr_password@localhost:5432/ocr_system
AUTH_REQUIRED=true
# Backend JWT verification fetches public signing keys from this project's JWKS endpoint.
SUPABASE_URL=https://your-project.supabase.co
# Browser-safe key used by backend Auth /user checks; never put a service-role key here.
SUPABASE_PUBLISHABLE_KEY=frontend-publishable-key
SUPABASE_SERVICE_ROLE_KEY=server-only-storage-key
SUPABASE_STORAGE_BUCKET=ocr-documents
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=frontend-publishable-key
VITE_SUPABASE_ANON_KEY=frontend-publishable-key
VITE_AUTH_REQUIRED=true
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=uploads
RAW_DATASET_PAGES_DIR=datasets/raw-pages
SOFFICE_CMD=soffice
# Gemini reads the page images (OCR, document type and attributes). Free key at https://aistudio.google.com/apikey
# Page images are sent to Google; free-tier requests may be used by Google to improve its products.
GEMINI_API_KEY=
GEMINI_EXTRACTION_MODEL=gemini-3.5-flash
GEMINI_PAGES_PER_REQUEST=6
GEMINI_IMAGE_MAX_EDGE=2048
GEMINI_TIMEOUT_SECONDS=180
GEMINI_REQUEST_DELAY_SECONDS=0
GEMINI_MAX_RETRIES=5
CELERY_TASK_ALWAYS_EAGER=false
VITE_API_BASE_URL=http://localhost:8000
VITE_AUTH_REQUIRED=true
ENABLE_DEBUG_ENDPOINTS=false
DEBUG_UPLOAD_MAX_BYTES=10485760
