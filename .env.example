DATABASE_URL=postgresql+psycopg2://ocr_user:ocr_password@localhost:5432/ocr_system
AUTH_REQUIRED=true
# Backend JWT verification fetches public signing keys from this project's JWKS endpoint.
SUPABASE_URL=https://your-project.supabase.co
# Browser-safe key used by backend Auth /user checks; never put a service-role key here.
SUPABASE_PUBLISHABLE_KEY=frontend-publishable-key
SUPABASE_SERVICE_ROLE_KEY=server-only-storage-key
SUPABASE_STORAGE_BUCKET=ocr-documents
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=frontend-publishable-key
VITE_SUPABASE_ANON_KEY=frontend-publishable-key
VITE_AUTH_REQUIRED=true
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=uploads
RAW_DATASET_PAGES_DIR=datasets/raw-pages
TESSERACT_CMD=tesseract
POPPLER_PATH=
SOFFICE_CMD=soffice
# LLM extraction: a multimodal Claude model reads the page image plus OCR tokens.
# With no key set the system falls back to OCR-only heuristics.
ANTHROPIC_API_KEY=
# "llm" or "ocr"; leave blank to use the LLM whenever ANTHROPIC_API_KEY is set.
EXTRACTION_BACKEND=
LLM_EXTRACTION_MODEL=claude-sonnet-5-5
CELERY_TASK_ALWAYS_EAGER=false
VITE_API_BASE_URL=http://localhost:8000
VITE_AUTH_REQUIRED=true
ENABLE_DEBUG_ENDPOINTS=false
DEBUG_UPLOAD_MAX_BYTES=10485760
