DATABASE_URL=postgresql+psycopg2://ocr_user:ocr_password@localhost:5432/ocr_system
AUTH_REQUIRED=true
# Backend JWT verification fetches public signing keys from this project's JWKS endpoint.
SUPABASE_URL=https://your-project.supabase.co
# Browser-safe key used by backend Auth /user checks; never put a service-role key here.
SUPABASE_PUBLISHABLE_KEY=frontend-publishable-key
SUPABASE_SERVICE_ROLE_KEY=server-only-storage-key
SUPABASE_STORAGE_BUCKET=ocr-documents
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=frontend-publishable-key
VITE_SUPABASE_ANON_KEY=frontend-publishable-key
VITE_AUTH_REQUIRED=true
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=uploads
RAW_DATASET_PAGES_DIR=datasets/raw-pages
SOFFICE_CMD=soffice
# Claude reads the page images (OCR, document type and attributes). Key from https://console.anthropic.com/
# Page images are sent to Anthropic for every document.
ANTHROPIC_API_KEY=
CLAUDE_EXTRACTION_MODEL=claude-sonnet-5-5
CLAUDE_PAGES_PER_REQUEST=6
CLAUDE_IMAGE_MAX_EDGE=2048
CLAUDE_TIMEOUT_SECONDS=180
CLAUDE_REQUEST_DELAY_SECONDS=0
# Claude's pixel coordinates are approximate, so attribute regions are off by default. Set to true to request them.
CLAUDE_REQUEST_BOXES=false
CELERY_TASK_ALWAYS_EAGER=false
VITE_API_BASE_URL=http://localhost:8000
VITE_AUTH_REQUIRED=true
ENABLE_DEBUG_ENDPOINTS=false
DEBUG_UPLOAD_MAX_BYTES=10485760
